{
  "name": "lib-result",
  "author": "Ahmad Othman",
  "license": "MIT",
  "engines": {
    "node": ">=16.9.0"
  },
  "version": "6.0.0",
  "description": "A Rust-inspired `Result` type for type-safe error handling in TypeScript and JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedOsman101/lib-result.git"
  },
  "homepage": "https://github.com/AhmedOsman101/lib-result/wiki",
  "keywords": [
    "typescript",
    "javascript",
    "result",
    "rust",
    "error-handling"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "unset BIOME_CONFIG_PATH; biome lint .",
    "format": "unset BIOME_CONFIG_PATH; biome check --fix .",
    "format:unsafe": "unset BIOME_CONFIG_PATH; biome check --fix --unsafe .",
    "build": "pnpm typecheck && tsdown --attw --publint",
    "typecheck": "tsc --noUnusedLocals false --noUnusedParameters false --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:cjs": "pnpm build && vitest run --config vitest.cjs.config.ts",
    "test:coverage": "pnpm build && vitest run --config vitest.coverage.config.ts --coverage",
    "prepublishOnly": "pnpm build && pnpm format",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "axios": "^1.20.0",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
